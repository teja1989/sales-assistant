# Copy to .env (or run `make env`). .env is git-ignored and cf-ignored; never commit real keys.
# Same names locally and on Cloud Foundry (there, set them with `cf set-env`; see docs/deployment-cloud-foundry.md).
# Leave the endpoint empty to use the offline mock model.

# ---- Azure OpenAI (official SDK) ----
AZURE_OPENAI_ENDPOINT=          # https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=        # deployment name, e.g. gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional for reasoning models (GPT-5 family): LLM_REASONING_EFFORT=low for faster replies.
# Temperature is not sent unless you set LLM_TEMPERATURE (older models only).

# ---- Data ----
# sim  = built-in simulator and demo personas (default)
# live = your MCP server only: the assistant uses whatever tools it exposes; sign-in asks for an
#        account number. No simulated data. See docs/live-mcp.md.
DATA_MODE=sim
LIVE_MCP_URL=
LIVE_MCP_TOKEN=                 # sent as "Authorization: Bearer <token>"

# Optional knobs (branding, timeouts, /mcp auth, demo password, ...) are in docs/configuration.md.
