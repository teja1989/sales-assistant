# Copy to .env (or run `make env`, which also generates the secrets).
# .env is git-ignored and cf-ignored. Never commit real keys.

APP_ENV=local                 # local | dev | prod | test
LOG_LEVEL=INFO

# ---- Assistant identity ----
APP_NAME=Tidelink
ASSISTANT_NAME=Tidelink         # the chat assistant
BRAND_NAME=                     # optional company name; leave empty to keep the provider unnamed
TAGLINE=Always on, like the tide.

# ---- LLM ----
# mock               : offline scripted model (no keys; good demo fallback)
# azure_openai       : Azure OpenAI deployments API
# openai_compatible  : any /chat/completions endpoint (e.g. Azure AI Foundry .../openai/v1)
LLM_PROVIDER=mock

AZURE_OPENAI_ENDPOINT=        # https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=      # your deployment name, e.g. gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

OPENAI_COMPAT_BASE_URL=       # e.g. https://<resource>.services.ai.azure.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_KEY_HEADER=authorization   # authorization (Bearer) | api-key

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_MAX_TOKENS_PARAM=max_tokens          # use max_completion_tokens for reasoning models
LLM_TIMEOUT_S=60

# ---- Our MCP server at /mcp ----
MCP_SERVER_TOKEN=             # required outside local; clients send "Authorization: Bearer <token>"
MCP_ALLOWED_HOSTS=            # optional Host allowlist, e.g. sales-assistant.apps.example.com

# ---- External ("live") MCP server for real data ----
LIVE_MCP_URL=                 # e.g. https://your-api.example.com/mcp
LIVE_MCP_TOKEN=
LIVE_MCP_AUTH_SCHEME=Bearer   # header becomes "Authorization: <scheme> <token>"; empty = raw token
LIVE_MCP_TIMEOUT_S=20
LIVE_TOOL_MAP=                # rename tools: our_name=their_name,our_name2=their_name2
LIVE_FALLBACK_TO_SIM=true     # if live fails, answer from the simulator and badge it "sim (fallback)"
DATA_SOURCE_OVERRIDE=         # empty = per-scenario settings | sim | live (force everything)

# ---- Sessions / handoff ----
HANDOFF_SECRET=               # required outside local (32+ chars)
OAUTH_SIGNING_SECRET=         # signs mock-IdP access tokens; required outside local (32+ chars)
OAUTH_REQUIRED=true           # chat sessions need a signed-in customer (OAuth access token)
OAUTH_TOKEN_TTL_S=1800
HANDOFF_TTL_S=300
SESSION_TTL_S=7200
MAX_TOOL_ROUNDS=6

# ---- Optional demo gate (HTTP basic auth on UI + API; /healthz and /mcp excluded) ----
DEMO_BASIC_AUTH_USER=
DEMO_BASIC_AUTH_PASSWORD=
RATE_LIMIT_PER_MINUTE=40

# ---- Cloud Foundry ----
SECRETS_SERVICE_NAME=sales-assistant-secrets
