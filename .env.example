# Copy to .env (or run `make env`). .env is git-ignored and cf-ignored; never commit real keys.
# These four are all you need. Leave a value empty to use the built-in simulation for it.

# Model: the URL we POST chat requests to (your proxy in front of Azure OpenAI).
# Empty = offline mock model (scripted flows, no network), handy as a demo fallback.
LLM_PROXY_URL=
# Optional key for the proxy. "Bearer <token>" is sent as the Authorization header;
# any other value is sent as the api-key header.
LLM_PROXY_KEY=

# Live data: your MCP server. Empty = simulator for everything.
# When set, every tool call goes live first and falls back to the simulator if the live server
# doesn't have that tool, can't be reached or returns an error (the trace shows "sim (fallback)").
LIVE_MCP_URL=
# Optional token, sent as "Authorization: Bearer <token>" (a value starting with a scheme, e.g.
# "Basic xyz", is sent as given).
LIVE_MCP_TOKEN=

# Optional knobs (branding, timeouts, /mcp auth, demo password, ...) are listed in docs/configuration.md.
