# Copy to .env (or run `make env`). .env is git-ignored and cf-ignored; never commit real keys.
# Same names locally and on Cloud Foundry (there, `make cf-secrets` stores them in the secrets service).
# Leave the endpoint empty to use the offline mock model.

# ---- Azure OpenAI (official SDK) ----
AZURE_OPENAI_ENDPOINT=          # https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=        # deployment name, e.g. gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Live data: your MCP server (empty = simulator for everything) ----
# Every tool goes live first and falls back to the simulator if the live server doesn't have it,
# can't be reached or returns an error (the trace shows "sim (fallback)").
LIVE_MCP_URL=
LIVE_MCP_TOKEN=                 # sent as "Authorization: Bearer <token>"

# Locally the SDK calls Azure directly. On Cloud Foundry the bound proxy service sets HTTPS_PROXY,
# which the SDK picks up automatically: nothing to add here.
# Optional knobs (branding, timeouts, /mcp auth, demo password, ...) are in docs/configuration.md.
